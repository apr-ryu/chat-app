generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model messages {
  id         Int       @id @default(autoincrement())
  sender     String?   @db.VarChar(50)
  recipient  String?   @db.VarChar(50)
  content    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model users {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
}